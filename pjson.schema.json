{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dumanhaydar/pjson-spec/pjson.schema.json",
  "title": "pjson",
  "description": "Extended Playlist JSON v1.0 — see SPEC.md",
  "type": "object",
  "required": ["pjson_version", "generated_at", "source", "categories", "languages", "channels", "movies", "series"],
  "additionalProperties": false,
  "properties": {
    "pjson_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
    "languages": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]{2,3}$" } },
    "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
    "movies": { "type": "array", "items": { "$ref": "#/$defs/movie" } },
    "series": { "type": "array", "items": { "$ref": "#/$defs/series" } }
  },
  "$defs": {
    "quality": { "enum": ["SD", "HD", "FHD", "UHD_4K", "UHD_8K", null] },
    "url": { "type": "string", "format": "uri" },
    "nullableUri": { "type": ["string", "null"], "format": "uri" },

    "source": {
      "type": "object",
      "required": ["kind", "server"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["api", "m3u", "m3u_plus"] },
        "server": { "type": "string", "format": "uri" },
        "username": { "type": "string" },
        "auth_in_url": { "type": "boolean" },
        "imported_from": { "type": "string" }
      }
    },

    "category": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["live", "movie", "series"] },
        "provider_id": { "type": "string" }
      }
    },

    "source_variant": {
      "type": "object",
      "required": ["stream_id", "url"],
      "additionalProperties": false,
      "properties": {
        "stream_id": { "type": "integer" },
        "quality": { "$ref": "#/$defs/quality" },
        "quality_label": { "type": ["string", "null"] },
        "ext": { "type": ["string", "null"] },
        "url": { "$ref": "#/$defs/url" }
      }
    },

    "channel": {
      "type": "object",
      "required": ["id", "kind", "name", "countries", "languages", "category_ids", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ch:" },
        "kind": { "const": "live" },
        "name": { "type": "string" },
        "logo": { "$ref": "#/$defs/nullableUri" },
        "epg_id": { "type": ["string", "null"] },
        "countries": { "type": "array", "items": { "type": "string" } },
        "languages": { "type": "array", "items": { "type": "string" } },
        "category_ids": { "type": "array", "items": { "type": "string" } },
        "tv_archive": { "type": "boolean" },
        "added": { "type": "string", "format": "date-time" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_variant" } }
      }
    },

    "movie": {
      "type": "object",
      "required": ["id", "kind", "title", "genres", "languages", "category_ids", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^movie:" },
        "kind": { "const": "movie" },
        "title": { "type": "string" },
        "genres": { "type": "array", "items": { "type": "string" } },
        "languages": { "type": "array", "items": { "type": "string" } },
        "countries": { "type": "array", "items": { "type": "string" } },
        "poster": { "$ref": "#/$defs/nullableUri" },
        "year": { "type": "integer" },
        "release_date": { "type": "string", "format": "date" },
        "rating": { "type": "number" },
        "duration_secs": { "type": "integer" },
        "plot": { "type": "string" },
        "external_ids": { "type": "object", "additionalProperties": { "type": "string" } },
        "category_ids": { "type": "array", "items": { "type": "string" } },
        "added": { "type": "string", "format": "date-time" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_variant" } }
      }
    },

    "episode": {
      "type": "object",
      "required": ["stream_id", "season", "episode", "url"],
      "additionalProperties": false,
      "properties": {
        "stream_id": { "type": "integer" },
        "season": { "type": "integer" },
        "episode": { "type": "integer" },
        "title": { "type": ["string", "null"] },
        "air_date": { "type": "string", "format": "date" },
        "poster": { "$ref": "#/$defs/nullableUri" },
        "duration_secs": { "type": "integer" },
        "ext": { "type": ["string", "null"] },
        "url": { "$ref": "#/$defs/url" }
      }
    },

    "season": {
      "type": "object",
      "required": ["season", "episodes"],
      "additionalProperties": false,
      "properties": {
        "season": { "type": "integer" },
        "poster": { "$ref": "#/$defs/nullableUri" },
        "episodes": { "type": "array", "items": { "$ref": "#/$defs/episode" } }
      }
    },

    "series": {
      "type": "object",
      "required": ["id", "kind", "title", "genres", "languages", "category_ids", "seasons"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^series:" },
        "kind": { "const": "series" },
        "title": { "type": "string" },
        "genres": { "type": "array", "items": { "type": "string" } },
        "languages": { "type": "array", "items": { "type": "string" } },
        "countries": { "type": "array", "items": { "type": "string" } },
        "poster": { "$ref": "#/$defs/nullableUri" },
        "backdrop": { "$ref": "#/$defs/nullableUri" },
        "year": { "type": "integer" },
        "rating": { "type": "number" },
        "plot": { "type": "string" },
        "external_ids": { "type": "object", "additionalProperties": { "type": "string" } },
        "provider_series_id": { "type": "integer" },
        "category_ids": { "type": "array", "items": { "type": "string" } },
        "seasons": { "type": "array", "items": { "$ref": "#/$defs/season" } }
      }
    }
  }
}
